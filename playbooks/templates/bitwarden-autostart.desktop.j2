[Desktop Entry]
Name=Bitwarden
GenericName=Password Manager
Comment=A secure and free password manager for all of your devices.
Exec={{ bitwarden_command }}
Icon={{ bitwarden_flatpak_id if password_default == "bitwarden-flatpak" else "bitwarden" }}
StartupWMClass=bitwarden
StartupNotify=false
Terminal=false
Type=Application
Categories=System;Security;
X-GNOME-Autostart-enabled=true
