#!/bin/bash
# Rebuilds/reinstalls Gregorio from lbssousa/gregorio at a given ref, reusing
# the same install-gregorio.sh logic used by the initial install.
#
# Usage: update-gregorio [ref]   (branch, tag, or commit; defaults to the
# ref pinned in install-gregorio.sh)
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    exec run0 "$0" "$@"
fi

if [ $# -ge 1 ]; then
    REF="$1" /opt/local-typesetting/scripts/install-gregorio.sh
else
    /opt/local-typesetting/scripts/install-gregorio.sh
fi
