# Managed by playbooks/user/bitwarden.yml.
[Unit]
Description=Bitwarden SSH agent proxy (launches Bitwarden if its agent is down)
Requires=bitwarden-ssh-agent.socket
After=bitwarden-ssh-agent.socket
StartLimitIntervalSec=0

[Service]
ExecStartPre={{ bitwarden_ssh_agent_launcher }}
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time={{ bitwarden_ssh_agent_proxy_idle }} %h/.var/app/{{ bitwarden_flatpak_id }}/data/.bitwarden-ssh-agent.sock
TimeoutStartSec={{ bitwarden_ssh_agent_launch_timeout + 30 }}
