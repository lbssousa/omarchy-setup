;;; omarchy-setup.el --- managed by omarchy-setup (playbooks/user/emacs.yml)  -*- lexical-binding: t; -*-
;; Edits here are overwritten on the next run; put your own settings in init.el.
;; Omarchy's own integration (omarchy.el, from the omarchy-emacs package) is
;; loaded by init.el before this file; font syncing is left entirely to it.

;;; Packages (AUCTeX and yasnippet live in GNU ELPA, lsp-mode in MELPA)
(require 'package)
{% for a in emacs_package_archives %}
(add-to-list 'package-archives '("{{ a.name }}" . "{{ a.url }}") t)
{% endfor %}
(package-initialize)

;;; yasnippet: snippets everywhere (TAB expands)
(when (package-installed-p 'yasnippet)
  (yas-global-mode 1))

;;; lsp-mode: installed but not started automatically (Eglot, built in, stays
;;; the default client); use M-x lsp, or e.g. (setq gregorio-lsp-client 'lsp-mode).
(when (package-installed-p 'lsp-mode)
  (setq lsp-keymap-prefix "C-c l"))

;;; AUCTeX
(when (package-installed-p 'auctex)
  (require 'tex-site nil t)
  (setq TeX-auto-save t
        TeX-parse-self t
        TeX-PDF-mode t
        TeX-view-program-selection '((output-pdf "xdg-open"))
        ;; Absolute path (%(abs-output)): xdg-open may run from another cwd.
        TeX-view-program-list '(("xdg-open" "xdg-open %(abs-output)")))
  (setq-default TeX-master nil)
  (add-hook 'LaTeX-mode-hook #'LaTeX-math-mode)
  (add-hook 'LaTeX-mode-hook #'turn-on-reftex)
  (add-hook 'LaTeX-mode-hook #'visual-line-mode)
  (setq reftex-plug-into-AUCTeX t)

  ;; Compile with latexmk. A latexmkrc (project-local, then user-level) decides
  ;; the engine and options; without one, LuaTeX (-lualatex, PDF output) is used.
  (defun omarchy-setup-latexmk-engine ()
    "Return \"-lualatex\" unless a latexmkrc applies to the current directory."
    (if (seq-some #'file-exists-p
                  (list (expand-file-name ".latexmkrc" default-directory)
                        (expand-file-name "latexmkrc" default-directory)
                        (expand-file-name "~/.latexmkrc")
                        (expand-file-name "latexmk/latexmkrc"
                                          (or (getenv "XDG_CONFIG_HOME") "~/.config"))))
        ""
      "-lualatex"))

  (defun omarchy-setup-abs-output ()
    "Return the absolute, shell-quoted path of the current output file."
    (shell-quote-argument
     (expand-file-name (TeX-active-master (TeX-output-extension)))))

  (with-eval-after-load 'tex
    (add-to-list 'TeX-expand-list '("%(abs-output)" omarchy-setup-abs-output))
    (setq-default TeX-engine 'luatex)
    (add-to-list 'TeX-expand-list
                 '("%(latexmk-engine)" omarchy-setup-latexmk-engine))
    (setf (alist-get "LatexMk" TeX-command-list nil nil #'equal)
          '("latexmk %(latexmk-engine) -synctex=1 -interaction=nonstopmode -file-line-error %t"
            TeX-run-TeX nil
            (plain-tex-mode latex-mode doctex-mode)
            :help "Run latexmk (latexmkrc first, LuaTeX fallback)"))
    (add-hook 'TeX-mode-hook
              (lambda () (setq TeX-command-default "LatexMk")))))

;;; Classic theme (themes/classic-theme.el, from emacs-jp/replace-colorthemes)
(menu-bar-mode 1)
(when (fboundp 'tool-bar-mode) (tool-bar-mode -1))
(when (fboundp 'scroll-bar-mode) (scroll-bar-mode -1))
(setq inhibit-startup-screen t)

;; The classic theme is Emacs' own theme here: Omarchy's color theme is not
;; used (its font syncing still is). omarchy.el applies its theme at startup
;; and on every Omarchy theme change, so that step is replaced by classic.
(add-to-list 'custom-theme-load-path
             (expand-file-name "themes" user-emacs-directory))

(defun omarchy-setup-apply-classic-theme ()
  "Make `classic' the only enabled theme."
  (interactive)
  (mapc #'disable-theme custom-enabled-themes)
  (load-theme 'classic t)
  ;; omarchy.el also pins the default face and the frame colors directly,
  ;; which wins over any theme: hand them back to the theme.
  (let ((bg (face-attribute 'default :background nil 'default))
        (fg (face-attribute 'default :foreground nil 'default)))
    (modify-all-frames-parameters
     `((background-color . ,bg) (foreground-color . ,fg)))))

(when (fboundp 'omarchy-apply-theme)
  (advice-add 'omarchy-apply-theme :override
              (lambda (&rest _) (omarchy-setup-apply-classic-theme))))

(omarchy-setup-apply-classic-theme)

(provide 'omarchy-setup)
;;; omarchy-setup.el ends here
