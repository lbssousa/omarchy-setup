#!/usr/bin/python3
# Managed by omarchy-setup (playbooks/keepassxc.yml). Do not edit.
#
# Native messaging host for KeePassXC-Browser inside the Flatpak browsers
# (Firefox and Brave). keepassxc-proxy can't run there (it needs
# KeePassXC's own Qt runtime), so this does what it does with the Python
# the browser runtime ships: strip the native messaging length prefix off
# what the browser sends and write the bare JSON to KeePassXC's browser
# socket, and length-prefix each JSON reply on the way back (the socket
# speaks unframed JSON).
# The socket lives in xdg-run/app/{{ keepassxc_flatpak_id }}, which the
# Flatpak browsers get an override for.
import json
import os
import socket
import struct
import sys
import threading

path = os.path.join(
    os.environ["XDG_RUNTIME_DIR"],
    "app",
    "{{ keepassxc_flatpak_id }}",
    "{{ keepassxc_flatpak_id }}.BrowserServer",
)

sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.connect(path)
stdin = sys.stdin.buffer
stdout = sys.stdout.buffer


def read_exactly(n):
    data = b""
    while len(data) < n:
        chunk = stdin.read(n - len(data))
        if not chunk:
            return None
        data += chunk
    return data


def to_socket():
    while True:
        header = read_exactly(4)
        if header is None:
            break
        message = read_exactly(struct.unpack("=I", header)[0])
        if message is None:
            break
        sock.sendall(message)
    # Firefox closed the pipe: the extension is gone.
    os._exit(0)


threading.Thread(target=to_socket, daemon=True).start()
pending = b""
while True:
    data = sock.recv(65536)
    if not data:
        break
    pending += data
    try:
        json.loads(pending)
    except ValueError:
        continue  # reply not complete yet
    stdout.write(struct.pack("=I", len(pending)) + pending)
    stdout.flush()
    pending = b""
