#!/bin/bash
# Managed by omarchy-setup (playbooks/user/apps/pdf.yml).
#
# Zathura's keybindings, in pt-BR, in the same searchable menu as Omarchy's
# Super+K. Zathura has no command that lists its bindings, so the defaults
# below are a translation of the MOUSE AND KEY BINDINGS section of
# zathura(1); the user's zathurarc (map/unmap, following include) goes on
# top: a rebound or unbound key leaves its default row, and each map adds a
# row with the function it runs.
#
# Usage: omarchy-setup-zathura-keybindings [--print|-p] [--pid <pid>] [--config <path>]
#   --pid     a Zathura process; a Flatpak one reads the Flatpak's zathurarc
#   --config  the zathurarc to read (default: the native build's, or the
#             Flatpak's when only that one exists)

print_only=false
pid=""
config_file=""

while (($#)); do
  case "$1" in
    --print|-p) print_only=true ;;
    --pid) shift; pid="$1" ;;
    --config) shift; config_file="$1" ;;
    *) config_file="$1" ;;
  esac
  shift
done

native_config="${XDG_CONFIG_HOME:-$HOME/.config}/zathura/zathurarc"
flatpak_config="$HOME/.var/app/org.pwmt.zathura/config/zathura/zathurarc"

if [[ -z $config_file ]]; then
  if [[ $pid =~ ^[0-9]+$ && -e /proc/$pid/root/.flatpak-info ]]; then
    config_file="$flatpak_config"
  elif [[ ! -f $native_config && -f $flatpak_config ]]; then
    config_file="$flatpak_config"
  else
    config_file="$native_config"
  fi
fi

[[ -f $config_file ]] || config_file=/dev/null

