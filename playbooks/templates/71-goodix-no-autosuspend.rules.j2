# Managed by playbooks/libfprint.yml.
#
# Disables USB autosuspend for the Goodix
# {{ libfprint_goodix_usb_vendor_id }}:{{ libfprint_goodix_usb_product_id }}
# fingerprint reader. Doesn't fix the protocol-desync bug on its own (see
# fprintd-desync-watchdog.service), but is harmless and may reduce how
# often it triggers.
ACTION=="add|change", SUBSYSTEM=="usb", ATTR{idVendor}=="{{ libfprint_goodix_usb_vendor_id }}", ATTR{idProduct}=="{{ libfprint_goodix_usb_product_id }}", TEST=="power/control", ATTR{power/control}="on"
