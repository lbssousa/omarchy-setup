# Managed by playbooks/user/apps/password.yml.
[Unit]
Description=Export the Bitwarden SSH agent's SSH_AUTH_SOCK to the systemd session
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemctl --user set-environment SSH_AUTH_SOCK={{ bitwarden_ssh_agent_socket }}
ExecStop=/usr/bin/systemctl --user unset-environment SSH_AUTH_SOCK
