# Managed by playbooks/user/bitwarden.yml. Static layer for IDEs and every
# systemd session process. Read by systemd --user at startup; inherited by
# Hyprland, terminals, VSCode, Zed, etc. Points straight at the Flatpak's
# sandboxed agent socket, which exists while Bitwarden runs (it autostarts
# at login) with the SSH agent enabled in its settings.
SSH_AUTH_SOCK={{ bitwarden_ssh_agent_socket }}
