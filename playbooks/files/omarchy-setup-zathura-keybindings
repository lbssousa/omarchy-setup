output_keybindings() {
  defaults | awk -v config_file="$config_file" '
BEGIN { FS = "\t" }

# girara reads <C-d> and <c-d> alike; plain keys are case-sensitive.
function norm(key) { return key ~ /^<.*>$/ ? tolower(key) : key }

function key_text(key,   inner, parts, count, i, text, name) {
  if (key !~ /^<.+>$/) return key
  inner = substr(key, 2, length(key) - 2)
  count = split(inner, parts, "-")
  # "<C-->" (Ctrl+minus) splits into an empty last part.
  if (parts[count] == "" && count > 1) { count--; parts[count] = "-" }
  text = ""
  for (i = 1; i < count; i++) {
    name = toupper(parts[i])
    if (name == "C") name = "CTRL"
    else if (name == "A" || name == "M") name = "ALT"
    else if (name == "S") name = "SHIFT"
    text = text name " + "
  }
  name = parts[count]
  if (tolower(name) in names) name = names[tolower(name)]
  else if (length(name) > 1) name = toupper(name)
  return text name
}

function mode_label(mode) {
  if (mode == "normal") return ""
  if (mode in modes) return "[" modes[mode] "] "
  return "[" toupper(mode) "] "
}

# Every map/unmap of one zathurarc, and of the files it includes.
function read_config(path, depth,   line, n, tok, i, mode, key, rest, dir) {
  if (depth > 8) return
  dir = path
  sub(/\/[^\/]*$/, "", dir)
  while ((getline line < path) > 0) {
    sub(/^[ \t]+/, "", line)
    if (line == "" || line ~ /^#/) continue
    n = split(line, tok, /[ \t]+/)
    if (tok[1] == "include" && n >= 2) {
      rest = tok[2]
      gsub(/^["\x27]|["\x27]$/, "", rest)
      sub(/^~/, ENVIRON["HOME"], rest)
      if (rest !~ /^\//) rest = dir "/" rest
      read_config(rest, depth + 1)
      continue
    }
    if (tok[1] != "map" && tok[1] != "unmap") continue
    i = 2
    mode = "normal"
    if (tok[i] ~ /^\[.+\]$/) { mode = substr(tok[i], 2, length(tok[i]) - 2); i++ }
    if (i > n) continue
    key = tok[i]
    gone[mode SUBSEP norm(key)] = 1
    if (tok[1] == "unmap") { delete custom[mode SUBSEP norm(key)]; continue }
    rest = ""
    for (i = i + 1; i <= n; i++) rest = rest (rest == "" ? "" : " ") tok[i]
    if (!((mode SUBSEP norm(key)) in custom)) order[++custom_count] = mode SUBSEP key
    custom[mode SUBSEP norm(key)] = rest
  }
  close(path)
}

function emit(combo, text) { printf "%-32s → %s\n", combo, text }

BEGIN {
  split("space=ESPAÇO backspace=BACKSPACE return=ENTER esc=ESC escape=ESC tab=TAB pageup=PAGE_UP pagedown=PAGE_DOWN left=SETA_ESQUERDA right=SETA_DIREITA up=SETA_CIMA down=SETA_BAIXO home=HOME end=END delete=DELETE insert=INSERT", pairs, " ")
  for (i in pairs) {
    split(pairs[i], kv, "=")
    names[kv[1]] = kv[2]
    gsub(/_/, " ", names[kv[1]])
  }
  modes["fullscreen"] = "TELA CHEIA"
  modes["presentation"] = "APRESENTAÇÃO"
  modes["index"] = "ÍNDICE"
  modes["mouse"] = "MOUSE"
  read_config(config_file, 0)
}

{
  mode = $1
  if (mode == "mouse") { emit(mode_label(mode) $2, $3); next }
  count = split($2, keys, " ")
  shown = ""
  for (i = 1; i <= count; i++) {
    if ((mode SUBSEP norm(keys[i])) in gone) continue
    shown = shown (shown == "" ? "" : ", ") key_text(keys[i])
  }
  if (shown != "") emit(mode_label(mode) shown, $3)
}

END {
  for (i = 1; i <= custom_count; i++) {
    split(order[i], mk, SUBSEP)
    if (!((mk[1] SUBSEP norm(mk[2])) in custom)) continue
    emit(mode_label(mk[1]) key_text(mk[2]), "zathurarc: " custom[mk[1] SUBSEP norm(mk[2])])
  }
}'
}

if [[ $print_only == true ]]; then
  output_keybindings
  exit 0
fi

records=$(output_keybindings)

monitor_height=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true) | .height' 2>/dev/null)
if [[ ! $monitor_height =~ ^[0-9]+$ ]] || ((monitor_height <= 0)); then
  monitor_height=900
fi

menu_height=$((monitor_height * 40 / 100))
printf '%s\n' "$records" | omarchy-menu-select "Atalhos do Zathura" -- --width 800 --height "$menu_height" >/dev/null || true
