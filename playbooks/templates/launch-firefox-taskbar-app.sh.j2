#!/bin/bash

# omarchy-setup-launch-firefox-taskbar-app: launch a Firefox Taskbar Tabs
# "tab app" (a site pinned to the Firefox taskbar as its own app-like window)
# by the Name= its own desktop launcher carries.
#
# Firefox writes one <flatpak id>.webapp-<uuid>.desktop per pinned site into
# ~/.local/share/applications, and both the uuid and the profile path in its
# Exec= line are per-install (the uuid is regenerated by a reinstall, the
# profile path by a profile reset), so neither can be named in a Hyprland
# keybind. The pinned tab's own title (Name=) is the one field that survives
# both, and is what playbooks/firefox-pwa-keybinds.yml passes in.
#
# Only the launcher is launched (gtk-launch, from gtk3): its Exec= line
# carries the -taskbar-tab and Multi-Account Containers -container flags the
# tab app was pinned with, so the window comes up in the container it was
# set up for. Already-running windows are left alone — Firefox opens a new
# window for a pinned app, the same as clicking its taskbar icon.
#
# Usage: omarchy-setup-launch-firefox-taskbar-app <tab app Name=>
set -euo pipefail

name="${1:-}"

if [[ -z "$name" ]]; then
  echo "Usage: omarchy-setup-launch-firefox-taskbar-app <tab app Name=>" >&2
  exit 1
fi

entry=""

for candidate in {{ firefox_webapp_desktop_glob }}; do
  [[ -f "$candidate" ]] || continue

  if [[ "$(sed -n 's/^Name=//p' "$candidate" | head -n1)" == "$name" ]]; then
    entry="$candidate"
    break
  fi
done

if [[ -z "$entry" ]]; then
  omarchy-notification-send -u low \
    "Firefox tab app not pinned: $name" \
    "Pin the site to the Firefox taskbar first (right-click the tab), then try again."
  exit 1
fi

exec gtk-launch "$(basename "$entry" .desktop)"
