#!/bin/bash
# Managed by playbooks/user/desktop.yml (omarchy-setup) — regenerates
# ~/.config/hypr/hyprsunset.conf with today's actual sunrise/sunset times
# for the configured (or IP-detected) location, then restarts hyprsunset so
# it picks up the new schedule. Meant to run once a day via the
# nightlight-solar-sync.timer systemd --user unit (also installed by the
# same playbook) — hyprsunset itself only understands fixed HH:MM profile
# times, not "sunrise"/"sunset", and those shift daily.
set -euo pipefail

CONF="$HOME/.config/hypr/hyprsunset.conf"
WEATHER_LOC="$HOME/.local/state/omarchy/settings/weather.json"

lat=""
lon=""

if [[ -f "$WEATHER_LOC" ]]; then
  lat=$(jq -r '.latitude // empty' "$WEATHER_LOC" 2>/dev/null || true)
  lon=$(jq -r '.longitude // empty' "$WEATHER_LOC" 2>/dev/null || true)
fi

if [[ -z "$lat" || -z "$lon" ]]; then
  # The service Omarchy's own weather location detects with. The response is
  # just coarse (city-level) geolocation, fine for sunrise/sunset math. Only
  # used as a fallback when `omarchy weather location --set` hasn't been run.
  geo=$(curl -fsS --max-time 5 "{{ nightlight_solar_geoip_url }}" || true)
  lat=$(jq -r '.latitude // empty' <<<"$geo" 2>/dev/null || true)
  lon=$(jq -r '.longitude // empty' <<<"$geo" 2>/dev/null || true)
fi

if [[ -z "$lat" || -z "$lon" ]]; then
  echo "nightlight-solar-sync: could not determine location" >&2
  exit 1
fi

sun=$(curl -fsS --max-time 5 "https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&daily=sunrise,sunset&timezone=auto")

sunrise=$(jq -r '.daily.sunrise[0]' <<<"$sun" | cut -dT -f2)
sunset=$(jq -r '.daily.sunset[0]' <<<"$sun" | cut -dT -f2)

if [[ -z "$sunrise" || -z "$sunset" || "$sunrise" == "null" || "$sunset" == "null" ]]; then
  echo "nightlight-solar-sync: could not determine sunrise/sunset" >&2
  exit 1
fi

cat >"$CONF" <<EOF
# Managed by nightlight-solar-sync (~/.local/bin/nightlight-solar-sync).
# Regenerated daily from today's sunrise/sunset for lat=${lat}, lon=${lon}.
# Manual edits here are overwritten on the next sync.
profile {
    time = ${sunrise}
    identity = true
}

profile {
    time = ${sunset}
    temperature = {{ nightlight_solar_night_temperature }}
}
EOF

# hyprsunset reads its profiles only at startup, so restart it. Not with
# `omarchy restart hyprsunset`: that relaunches it in the background, and when
# this script runs as the oneshot nightlight-solar-sync.service, systemd kills
# the relaunch along with the service as soon as the script exits, leaving no
# hyprsunset at all (and so no night light at sunset). A transient service
# unit is started synchronously and lives outside this service.
pkill -x hyprsunset || true
uwsm app -t service -- hyprsunset

# hyprsunset switches profiles on its own and tells nobody, so the shell's
# night light indicator would keep showing the old state. Refresh it a few
# seconds after each switch (daily, so it keeps working even on a day this
# sync doesn't run), and right now for the profile just applied.
for edge in sunrise sunset; do
  systemctl --user stop "nightlight-solar-refresh-${edge}.timer" 2>/dev/null || true
  systemctl --user reset-failed "nightlight-solar-refresh-${edge}.service" 2>/dev/null || true
done
systemd-run --user --quiet --collect --unit=nightlight-solar-refresh-sunrise \
  --on-calendar="*-*-* ${sunrise}:05" --timer-property=AccuracySec=1s --timer-property=Persistent=true \
  -- omarchy-shell -q nightlight refresh
systemd-run --user --quiet --collect --unit=nightlight-solar-refresh-sunset \
  --on-calendar="*-*-* ${sunset}:05" --timer-property=AccuracySec=1s --timer-property=Persistent=true \
  -- omarchy-shell -q nightlight refresh

sleep 2
omarchy-shell -q nightlight refresh || true
