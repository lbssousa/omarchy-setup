# Managed by playbooks/system/bgrt-theme.yml.
#
# SDDM reads /etc/sddm.conf.d in name order and the last value wins: this
# sorts after Omarchy's 10-theme.conf, 99-omarchy-login.conf and
# autologin.conf, which all say Current=omarchy, and before omarchy-multiuser's
# zz-omarchy-multiuser.conf, whose greeter (password search, power keys) stays
# in charge when that package is installed.
[Theme]
Current={{ bgrt_sddm_theme_name }}
