-- Managed by playbooks/system/desktop.yml (feature text-size).
--
-- The SDDM greeter's Hyprland config: Omarchy's own, run as is, plus a
-- monitor rule pinning the scale. Omarchy's has none, so Hyprland picks a
-- scale from the panel's DPI and the login screen comes up larger than the
-- desktop, which runs at omarchy_monitor_scale.
dofile("{{ sddm_greeter_stock_hyprland_config }}")

hl.monitor({ output = "", mode = "preferred", position = "auto", scale = {{ omarchy_monitor_scale }} })
