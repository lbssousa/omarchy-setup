#!/usr/bin/env bash

# Hold the default password manager's autostart until the Omarchy desktop is
# actually up — the ExecStartPre= of its systemd-xdg-autostart unit (see
# playbooks/user/apps/password.yml). The app's name ($1) is only for the log.
#
# systemd's XDG autostart starts the entry right at graphical-session.target
# (it ignores X-GNOME-Autostart-Delay), before quickshell registers the
# system tray (org.kde.StatusNotifierWatcher / StatusNotifierHost) and
# before xdg-desktop-portal answers. Both apps look for the tray only once:
# Bitwarden (Electron) when it creates its tray icon, KeePassXC (Qt5) at
# startup, when it also reads the portal's org.freedesktop.appearance
# color-scheme to pick its dark theme. Launched early, they come up without
# a tray icon (and KeePassXC with the stock light theme); restarting them
# after login "fixes" it only because the environment happens to be ready
# by then. gsettings is no signal: it already says prefer-dark at boot, a
# second before the portal is up. Wait up to the timeout for both, then let
# the app start regardless so a slowly starting desktop never swallows the
# autostart entry.
set -uo pipefail

app=${1:-the password manager}
timeout=${PASSWORD_AUTOSTART_TIMEOUT:-60}

for ((i = 0; i < timeout; i++)); do
  tray=$(
    busctl --user get-property \
      org.kde.StatusNotifierWatcher /StatusNotifierWatcher \
      org.kde.StatusNotifierWatcher IsStatusNotifierHostRegistered \
      2>/dev/null
  )

  if [[ $tray == *" true"* ]] &&
    busctl --user --timeout=2 call \
      org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop \
      org.freedesktop.portal.Settings ReadOne ss \
      org.freedesktop.appearance color-scheme &>/dev/null; then
    exit 0
  fi

  sleep 1
done

echo "Desktop not ready after ${timeout}s; starting $app anyway" >&2
exit 0
