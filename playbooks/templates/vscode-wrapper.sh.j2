#!/usr/bin/env bash
# Managed by omarchy-setup (playbooks/snap.yml).
# The snap always runs under XWayland, where Hyprland doesn't scale the
# window and Electron reads the integer GDK_SCALE; pass the UI scale as an
# explicit device scale factor instead.
export GDK_SCALE=1
exec {{ vscode_snap_bin }} --force-device-scale-factor={{ vscode_scale_factor }} "$@"
