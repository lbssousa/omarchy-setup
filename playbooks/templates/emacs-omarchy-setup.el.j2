;;; omarchy-setup.el --- managed by omarchy-setup (playbooks/emacs.yml)  -*- lexical-binding: t; -*-
;; Edits here are overwritten on the next run; put your own settings in init.el.
;; Omarchy's own integration (omarchy.el, from the omarchy-emacs package) is
;; loaded by init.el before this file; font syncing is left entirely to it.

;;; Packages (AUCTeX lives in GNU ELPA)
(require 'package)
(add-to-list 'package-archives '("gnu" . "https://elpa.gnu.org/packages/"))
(package-initialize)

;;; AUCTeX
(when (package-installed-p 'auctex)
  (require 'tex-site nil t)
  (setq TeX-auto-save t
        TeX-parse-self t
        TeX-PDF-mode t
        TeX-view-program-selection '((output-pdf "xdg-open"))
        TeX-view-program-list '(("xdg-open" "xdg-open %o")))
  (setq-default TeX-master nil)
  (add-hook 'LaTeX-mode-hook #'LaTeX-math-mode)
  (add-hook 'LaTeX-mode-hook #'turn-on-reftex)
  (add-hook 'LaTeX-mode-hook #'visual-line-mode)
  (setq reftex-plug-into-AUCTeX t))

;;; Classic look (themes/classic-theme.el, from emacs-jp/replace-colorthemes)
(menu-bar-mode 1)
(when (fboundp 'tool-bar-mode) (tool-bar-mode -1))
(when (fboundp 'scroll-bar-mode) (scroll-bar-mode -1))
(setq inhibit-startup-screen t)

(defun omarchy-setup-enable-classic-theme ()
  "Load and enable the classic theme on top of Omarchy's."
  (add-to-list 'custom-theme-load-path
               (expand-file-name "themes" user-emacs-directory))
  (load-theme 'classic t))

(omarchy-setup-enable-classic-theme)

;; omarchy.el re-applies its own theme whenever Omarchy's theme changes;
;; put the classic one back on top afterwards.
(when (fboundp 'omarchy-apply-theme)
  (advice-add 'omarchy-apply-theme :after
              (lambda (&rest _) (omarchy-setup-enable-classic-theme))))

(provide 'omarchy-setup)
;;; omarchy-setup.el ends here
